{
  "name": "decentralized-idp-idpfront",
  "version": "0.1.0",
  "description": "The login page the gateway serves at /login: turns a password into the authentication assertion in the browser",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build --prefix ../sdk && vite build",
    "typecheck": "npm run build --prefix ../sdk && tsc --noEmit",
    "qa-gate": "npm run typecheck && vite build"
  },
  "dependencies": {
    "@decentralized-idp/sdk": "0.1.0",
    "@noble/curves": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.8.2",
    "vite": "^8.3.0"
  }
}
