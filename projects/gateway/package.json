{
  "name": "decentralized-idp-gateway",
  "version": "0.1.0",
  "description": "OAuth authorization server in front of the identity nodes: relays FROST rounds, aggregates the group signatures, publishes the JWKS, serves the login page",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --prefix ../sdk && vitest run",
    "test:watch": "vitest",
    "qa-gate": "npm run build --prefix ../sdk && npm run typecheck && npm run build && vitest run --coverage"
  },
  "dependencies": {
    "@decentralized-idp/sdk": "0.1.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@noble/curves": "^1.8.1",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "hono": "^4.13.8",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  }
}
