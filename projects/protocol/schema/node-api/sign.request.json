{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roundId": {
      "type": "string",
      "minLength": 1
    },
    "refreshRoundId": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "properties": {
        "clientAssertion": {
          "type": "string",
          "minLength": 1
        },
        "grant": {
          "type": "string",
          "enum": [
            "authorization_code",
            "refresh_token"
          ]
        },
        "assertion": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "dpopProof": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "object",
          "properties": {
            "iat": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "exp": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "jti": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "iat",
            "exp",
            "jti"
          ]
        },
        "commitments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "D": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "E": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "nodeId",
              "D",
              "E"
            ]
          }
        },
        "refreshCommitments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "D": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "E": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "nodeId",
              "D",
              "E"
            ]
          }
        },
        "allParticipants": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          }
        }
      },
      "required": [
        "clientAssertion",
        "grant",
        "dpopProof",
        "claims",
        "commitments",
        "refreshCommitments",
        "allParticipants"
      ]
    }
  },
  "required": [
    "roundId",
    "refreshRoundId",
    "request"
  ]
}
