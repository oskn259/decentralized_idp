{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodeId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "toprfPartial": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "ct_i": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sub": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "nodeId",
    "toprfPartial",
    "ct_i",
    "sub"
  ]
}
