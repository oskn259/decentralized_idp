{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "const": "ok"
    },
    "nodeId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "groupPublicKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "publicUrl": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "status",
    "nodeId",
    "groupPublicKey",
    "publicUrl"
  ]
}
