{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roundId": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "blinded": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sessionNonce": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "cnfJkt": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "iat": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "commitments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "D": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "E": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "nodeId",
              "D",
              "E"
            ]
          }
        },
        "allParticipants": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          }
        }
      },
      "required": [
        "username",
        "blinded",
        "sessionNonce",
        "cnfJkt",
        "clientId",
        "scope",
        "iat",
        "exp",
        "commitments",
        "allParticipants"
      ]
    }
  },
  "required": [
    "roundId",
    "request"
  ]
}
